// MariaDB through Prisma's MariaDB driver adapter. Event logs and other structured blobs are
// serialized by the application (JSON in text columns), not stored in the database's JSON type.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Participant {
  id             String  @id @db.VarChar(64)
  name           String  @unique @db.VarChar(100)
  /// SHA-256 of the program token (tokens are high-entropy random strings, so a fast hash suffices).
  tokenHash      String? @unique @db.Char(64)
  /// Last four characters of the token, to recognize it.
  tokenPreview   String? @db.VarChar(8)
  tokenCreatedAt BigInt?
  tokenReplaced  Boolean @default(false)
  tokenNoticeAt  BigInt?
  /// Admin policy: programs of this participant may connect over plain ws:// (otherwise only wss://).
  allowInsecure  Boolean @default(false)
  /// Connection signals raised before this moment count as reviewed by the admin (0 = never reviewed).
  activityReviewedAt BigInt @default(0)
  createdAt      BigInt

  connections ProgramConnection[]
}

/// One accepted program connection, or one denied attempt (a valid token on somebody else's lobby). Pruned after 30 days.
model ProgramConnection {
  id             String  @id @db.VarChar(64)
  participantId  String  @db.VarChar(64)
  /// "connected" or "denied".
  kind           String  @db.VarChar(16)
  at             BigInt
  endedAt        BigInt?
  endReason      String? @db.VarChar(200)
  ip             String  @db.VarChar(64)
  secure         Boolean
  programName    String? @db.VarChar(100)
  programVersion String? @db.VarChar(100)
  lobbyId        String  @db.VarChar(40)
  seat           Int?
  /// Set when a connection from this other address took this one over while it was active.
  takeoverIp     String? @db.VarChar(64)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, at])
  @@index([at])
}

model Ruleset {
  id        String  @id @db.VarChar(40)
  data      String  @db.Text
  enabled   Boolean
  createdAt BigInt
}

model Setting {
  key   String @id @db.VarChar(64)
  value String @db.Text
}

model Lobby {
  id             String  @id @db.VarChar(16)
  rulesetId      String  @db.VarChar(40)
  godMode        Boolean
  stopOnInfraction Boolean @default(false)
  createdBy      String  @db.VarChar(64)
  /// JSON: { kind: "participant", participantId } or { kind: "bot", bot }.
  seat1          String  @db.VarChar(200)
  seat2          String  @db.VarChar(200)
  createdAt      BigInt
  lastActivityAt BigInt

  series Series[]
  games  Game[]
}

model Series {
  id          String  @id @db.VarChar(64)
  lobbyId     String  @db.VarChar(16)
  target      Int
  played      Int
  score1      Int
  score2      Int
  status      String  @db.VarChar(16)
  abortReason String? @db.VarChar(500)
  startedAt   BigInt
  endedAt     BigInt?
  /// JSON heatmap accumulated over the series.
  heatmap     String  @db.Text

  lobby Lobby  @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  games Game[]

  @@index([lobbyId])
}

model Game {
  id           String  @id @db.VarChar(64)
  lobbyId      String  @db.VarChar(16)
  seriesId     String  @db.VarChar(64)
  idx          Int
  first        Int
  status       String  @db.VarChar(8)
  winner       Int?
  reason       String? @db.VarChar(16)
  startedAt    BigInt
  endedAt      BigInt
  shots1       Int
  shots2       Int
  infractions1 Int
  infractions2 Int
  /// JSON array of game events and the matching timestamps.
  events       String  @db.MediumText
  times        String  @db.MediumText
  summary      String? @db.Text

  lobby  Lobby  @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId, idx])
  @@index([lobbyId])
}

model AuditLog {
  id     BigInt  @id @default(autoincrement())
  at     BigInt
  actor  String  @db.VarChar(120)
  action String  @db.VarChar(64)
  target String? @db.VarChar(200)
  detail String? @db.VarChar(500)

  @@index([at])
}

model WebSession {
  /// SHA-256 of the session cookie value.
  idHash        String  @id @db.Char(64)
  /// "gate" (shared password verified, no identity yet), "participant" or "admin".
  role          String  @db.VarChar(12)
  participantId String? @db.VarChar(64)
  adminUsername String? @db.VarChar(100)
  createdAt     BigInt
  expiresAt     BigInt

  @@index([expiresAt])
}
