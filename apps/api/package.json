{
  "name": "@bsc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "test:int": "vitest run -c vitest.int.config.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "hash-password": "tsx src/hash-password.ts"
  },
  "dependencies": {
    "@bsc/api-contract": "workspace:*",
    "@bsc/bots": "workspace:*",
    "@bsc/engine": "workspace:*",
    "@bsc/protocol": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "^5.3.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24",
    "@types/ws": "^8.18.1",
    "mariadb": "^3.4.5",
    "tsx": "^4.20.0",
    "vitest": "^5.0.5"
  }
}
