# Copy to .env for local runs, or set these in Coolify. Never commit real values.

NODE_ENV=production
PORT=3000

# MariaDB connection: mysql://user:password@host:3306/database
DATABASE_URL=mysql://battleships:change-me@db:3306/battleships

# The public address of the site, with scheme and no trailing slash. Used for the CSRF origin check.
PUBLIC_ORIGIN=https://battleships.example.com

# Number of reverse proxies in front of the API whose X-Forwarded-For header can be trusted
# (Coolify's proxy: 1). Leave 0 when the API is reached directly.
TRUST_PROXY_HOPS=1

# Passwords are stored as scrypt hashes. Create one with:
#   pnpm --filter @bsc/api hash-password
SHARED_PASSWORD_HASH=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Optional overrides of the platform constants (defaults shown)
# MOVE_TIMEOUT_MS=10000
# PLACE_TIMEOUT_MS=10000
# GRACE_MS=60000
# IDLE_EXPIRY_MS=7200000
# MAX_OPEN_LOBBIES=10
# MAX_STRIKES=3
# SESSION_TTL_HOURS=168
