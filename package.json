{
  "name": "battleships-championship",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @bsc/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test:e2e": "pnpm --filter @bsc/web test:e2e",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:int && pnpm test:e2e",
    "test:int": "pnpm --filter @bsc/api test:int"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
